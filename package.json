{
  "name": "boq-lint",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BOQ Lint（清单校核）是一款面向工程造价与 Quantity Surveying 工作流的本地工程量清单 Excel 辅助检查器。",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": "10.13.1"
  },
  "packageManager": "pnpm@10.13.1",
  "keywords": [
    "工程造价",
    "工程量清单",
    "清单校核",
    "Excel",
    "BOQ",
    "Bill of Quantities",
    "Quantity Surveying",
    "Construction Cost",
    "Cost Estimation",
    "Tendering"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --pretty false && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "generate:samples": "tsx scripts/generate-samples.ts",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
