{
  "name": "boq-lint",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BOQ Lint（清单校核）是一款面向工程造价与 Quantity Surveying 工作流的本地工程量清单 Excel 辅助检查器。",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.16.0",
  "keywords": [
    "工程造价",
    "工程量清单",
    "清单校核",
    "Excel",
    "BOQ",
    "Bill of Quantities",
    "Quantity Surveying",
    "Construction Cost",
    "Cost Estimation",
    "Tendering"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --pretty false && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run package && playwright test",
    "samples": "tsx scripts/generate-samples.ts",
    "generate:samples": "tsx scripts/generate-samples.ts",
    "build:offline": "tsc -b --pretty false && vite build --config vite.offline.config.ts && node scripts/finalize-offline.mjs",
    "package": "npm run samples && npm run build && npm run build:offline && node scripts/hash-release.mjs",
    "capture:docs": "tsx scripts/capture-docs.ts",
    "screenshots": "npm run capture:docs",
    "preview": "vite preview",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run build:offline"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  }
}
